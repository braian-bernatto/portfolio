---
import { getPortfolio } from '../data/portfolio';
import { getUi } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { profile } = getPortfolio(locale);
const t = getUi(locale);
const pillars = t.pillars;
const pillarIcons = ['lucide:layers', 'lucide:book-open-text', 'lucide:shield-check'];
const s = t.sections.about;
---

<section id="about" class="scroll-mt-24 py-20 sm:py-28">
  <div class="u-container">
    <SectionHeading eyebrow={s.eyebrow} title={s.title} description={profile.summary} />

    <div class="grid gap-4 sm:grid-cols-3">
      {
        pillars.map((p, i) => (
          <article
            class="reveal neu group relative flex flex-col gap-3 rounded-2xl p-6"
            data-delay={i * 90}
          >
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand/12 text-brand-bright ring-1 ring-brand/25 transition-transform duration-300 group-hover:scale-110">
              <Icon name={pillarIcons[i]} class="h-5 w-5" />
            </span>
            <h3 class="font-display text-lg font-bold text-ink">{p.title}</h3>
            <p class="text-sm leading-relaxed text-muted">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
