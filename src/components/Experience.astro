---
import { getPortfolio } from '../data/portfolio';
import { getUi } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { experience } = getPortfolio(locale);
const t = getUi(locale);
const s = t.sections.experience;
---

<section id="experience" class="scroll-mt-24 py-20 sm:py-28">
  <div class="u-container">
    <SectionHeading eyebrow={s.eyebrow} title={s.title} description={s.description} />

    <ol class="relative ml-2 border-l border-white/10 sm:ml-4">
      {
        experience.map((job, i) => (
          <li class="reveal relative pb-12 last:pb-0" data-delay={i * 70}>
            <span
              class:list={[
                'absolute -left-[1.18rem] top-1 grid h-7 w-7 place-items-center rounded-full ring-4 ring-bg',
                job.current
                  ? 'bg-brand text-void'
                  : 'bg-surface text-brand-bright ring-white/5',
              ]}
            >
              {job.current ? (
                <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-void" />
              ) : (
                <Icon name="lucide:briefcase" class="h-3.5 w-3.5" />
              )}
            </span>

            <div class="ml-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-display text-lg font-bold text-ink sm:text-xl">
                  {job.company}
                </h3>
                <span
                  class:list={[
                    'font-mono text-xs',
                    job.current ? 'text-brand-bright' : 'text-faint',
                  ]}
                >
                  {job.start} — {job.end}
                </span>
              </div>

              <p class="mt-0.5 text-sm font-semibold text-muted">
                {job.role}
                {job.current && (
                  <span class="ml-2 rounded-full bg-brand/15 px-2 py-0.5 text-[0.65rem] font-semibold text-brand-bright">
                    {t.misc.current}
                  </span>
                )}
              </p>

              {job.summary && (
                <p class="mt-3 text-sm leading-relaxed text-muted">{job.summary}</p>
              )}

              <div class="mt-4 grid gap-2.5">
                {job.highlights.map((h) => (
                  <div class="rounded-xl border border-white/8 bg-white/[0.02] p-4 transition-colors duration-200 hover:border-brand/30 hover:bg-brand/[0.04]">
                    <p class="flex items-center gap-2 text-sm font-semibold text-ink">
                      <Icon name="lucide:chevron-right" class="h-4 w-4 text-brand-bright" />
                      {h.title}
                    </p>
                    <p class="mt-1.5 pl-6 text-sm leading-relaxed text-muted">{h.body}</p>
                  </div>
                ))}
              </div>

              <ul class="mt-4 flex flex-wrap gap-2">
                {job.stack.map((tech) => (
                  <li class="chip">{tech}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
