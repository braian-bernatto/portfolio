---
import { getPortfolio } from '../data/portfolio';
import { getUi } from '../i18n/ui';
import { languageLabels } from '../i18n/config';
import type { Locale } from '../i18n/config';
import { Icon } from 'astro-icon/components';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { profile } = getPortfolio(locale);
const t = getUi(locale);

const resumeHref = locale === 'es' ? '/es/resume' : '/resume';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isEs = path === '/es' || path.startsWith('/es/');
const altLocale: Locale = locale === 'es' ? 'en' : 'es';
const altPath = isEs ? path.replace(/^\/es/, '') || '/' : `/es${path === '/' ? '' : path}`;
const altHref = altPath === '/' ? '/' : altPath;
---

<header class="fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-3 sm:pt-4">
  <nav class="glass u-container flex items-center justify-between gap-3 rounded-2xl px-3 py-2.5 sm:px-5">
    <a href="#top" class="group flex items-center gap-2.5" aria-label={profile.name}>
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand/15 text-brand-bright ring-1 ring-brand/30 transition-transform duration-300 group-hover:scale-105">
        <span class="font-display text-sm font-extrabold">BB</span>
      </span>
      <span class="hidden font-display text-sm font-bold tracking-tight text-ink sm:block">
        {profile.firstName}<span class="text-brand-bright">.</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        t.nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-active="false"
              class="nav-link relative rounded-lg px-3.5 py-2 text-sm font-medium text-muted transition-colors duration-200 hover:text-ink data-[active=true]:text-ink"
            >
              {item.label}
              <span class="absolute inset-x-3 -bottom-px h-px origin-left scale-x-0 bg-brand-bright transition-transform duration-300 data-[active=true]:scale-x-100" data-active="false" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={altHref}
        class="inline-flex items-center gap-1.5 rounded-xl glass px-3 py-2 text-sm font-semibold text-muted transition-all duration-200 hover:text-brand-bright"
        aria-label={languageLabels[altLocale]}
        title={languageLabels[altLocale]}
      >
        <Icon name="lucide:languages" class="h-4 w-4" />
        <span class="hidden sm:inline">{languageLabels[altLocale]}</span>
      </a>
      <a
        href={resumeHref}
        class="hidden items-center gap-1.5 rounded-xl border border-brand/40 bg-brand/10 px-3.5 py-2 text-sm font-semibold text-brand-bright transition-all duration-200 hover:bg-brand/20 hover:shadow-[0_0_24px_-6px] hover:shadow-brand/50 sm:flex"
      >
        <Icon name="lucide:file-text" class="h-4 w-4" />
        {t.actions.resume}
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        class="grid h-10 w-10 place-items-center rounded-xl glass px-0 md:hidden"
      >
        <Icon name="lucide:menu" class="h-5 w-5 text-ink" data-icon="open" />
        <Icon name="lucide:x" class="hidden h-5 w-5 text-ink" data-icon="close" />
      </button>
    </div>
  </nav>
</header>

<div id="mobile-menu" class="fixed inset-0 z-40 hidden md:hidden" data-open="false">
  <div class="absolute inset-0 bg-void/70 backdrop-blur-sm" data-menu-close></div>
  <div class="glass-strong absolute inset-x-3 top-20 rounded-2xl p-3">
    <ul class="flex flex-col">
      {
        t.nav.map((item) => (
          <li>
            <a
              href={item.href}
              data-menu-close
              class="flex items-center justify-between rounded-xl px-4 py-3 text-base font-medium text-muted transition-colors hover:bg-white/5 hover:text-ink"
            >
              {item.label}
              <Icon name="lucide:arrow-up-right" class="h-4 w-4 opacity-50" />
            </a>
          </li>
        ))
      }
      <li class="mt-2 border-t border-white/10 pt-2">
        <a
          href={altHref}
          data-menu-close
          class="mb-2 flex items-center justify-between rounded-xl px-4 py-3 text-base font-medium text-muted transition-colors hover:bg-white/5 hover:text-ink"
        >
          {languageLabels[altLocale]}
          <Icon name="lucide:languages" class="h-4 w-4 opacity-70" />
        </a>
        <a
          href={resumeHref}
          data-menu-close
          class="mb-2 flex items-center justify-between rounded-xl px-4 py-3 text-base font-medium text-muted transition-colors hover:bg-white/5 hover:text-ink"
        >
          {t.actions.resume}
          <Icon name="lucide:file-text" class="h-4 w-4 opacity-70" />
        </a>
        <a
          href="#contact"
          data-menu-close
          class="flex items-center justify-between rounded-xl bg-brand/10 px-4 py-3 text-base font-semibold text-brand-bright"
        >
          {t.actions.getInTouch}
          <Icon name="lucide:send" class="h-4 w-4" />
        </a>
      </li>
    </ul>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = toggle?.querySelector('[data-icon=open]');
  const closeIcon = toggle?.querySelector('[data-icon=close]');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
