---
import { getPortfolio } from '../data/portfolio';
import { getUi } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { skillGroups } = getPortfolio(locale);
const t = getUi(locale);
const s = t.sections.skills;
---

<section id="skills" class="scroll-mt-24 py-20 sm:py-28">
  <div class="u-container">
    <SectionHeading eyebrow={s.eyebrow} title={s.title} description={s.description} />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        skillGroups.map((group, gi) => (
          <article
            class="reveal glass group flex flex-col rounded-2xl p-5 transition-transform duration-300 hover:-translate-y-1"
            data-delay={(gi % 4) * 70}
          >
            <div class="mb-4 flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand/12 text-brand-bright ring-1 ring-brand/25 transition-transform duration-300 group-hover:scale-110">
                <Icon name={group.icon} class="h-5 w-5" />
              </span>
              <h3 class="font-display text-sm font-bold tracking-tight text-ink">
                {group.title}
              </h3>
            </div>
            <ul class="flex flex-wrap gap-1.5">
              {group.skills.map((sk) => (
                <li class="chip">
                  {sk.icon && <Icon name={sk.icon} class="h-3.5 w-3.5" />}
                  {sk.name}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
