---
import { getPortfolio } from '../data/portfolio';
import { getUi } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import { Icon } from 'astro-icon/components';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { profile, socials } = getPortfolio(locale);
const t = getUi(locale);
const year = new Date().getFullYear();
const resumeHref = locale === 'es' ? '/es/resume' : '/resume';
---

<footer class="relative mt-10 border-t border-white/8 py-12">
  <div class="u-container">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <a href="#top" class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand/15 text-brand-bright ring-1 ring-brand/30">
            <span class="font-display text-sm font-extrabold">BB</span>
          </span>
          <span class="font-display text-sm font-bold text-ink">{profile.name}</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
          {profile.role} · {profile.location}. {profile.tagline}
        </p>
        <div class="mt-5 flex gap-2.5">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
                aria-label={s.label}
                title={s.label}
                class="grid h-9 w-9 place-items-center rounded-lg glass text-muted transition-all duration-200 hover:text-brand-bright hover:-translate-y-0.5"
              >
                <Icon name={s.icon} class="h-4 w-4" />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <p class="eyebrow mb-4">{t.footer.navigate}</p>
        <ul class="flex flex-col gap-2">
          {
            t.nav.map((n) => (
              <li>
                <a href={n.href} class="link-underline text-sm text-muted hover:text-ink">{n.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/8 pt-6 sm:flex-row">
      <p class="text-xs text-faint">
        © {year} {profile.name}. {t.footer.builtWith}
      </p>
      <div class="flex items-center gap-4">
        <a href={resumeHref} class="link-underline text-xs font-semibold text-muted transition-colors hover:text-brand-bright">
          {t.actions.resume}
        </a>
        <a href="#top" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted transition-colors hover:text-brand-bright">
          {t.actions.backToTop}
          <Icon name="lucide:arrow-up" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </div>
</footer>
