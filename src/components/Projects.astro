---
import { getPortfolio } from '../data/portfolio';
import { getUi } from '../i18n/ui';
import type { Locale } from '../i18n/config';
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { projects, profile } = getPortfolio(locale);
const t = getUi(locale);
const s = t.sections.projects;
const featureds = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="projects" class="scroll-mt-24 py-20 sm:py-28">
  <div class="u-container">
    <SectionHeading eyebrow={s.eyebrow} title={s.title} description={s.description} />

    <div class="space-y-4">
      {
        featureds.map((p, fi) => {
          const flip = fi % 2 === 1;
          const coverSrc = p.gallery?.[0] ?? p.image ?? '/projects/banking/dashboard.svg';
          return (
            <article
              class="reveal glass group relative grid gap-0 overflow-hidden rounded-3xl lg:grid-cols-2"
              data-delay="0"
            >
              <div
                class:list={['relative flex flex-col overflow-hidden bg-surface lg:aspect-auto', flip && 'lg:order-2']}
                {...(p.gallery?.length
                  ? { 'data-gallery': '', 'data-name': p.name, 'data-screenshot': t.misc.screenshot, 'data-index': '0' }
                  : {})}
              >
                <div class="relative aspect-[16/11] flex-1 overflow-hidden">
                  {p.gallery?.length ? (
                    <button
                      type="button"
                      data-gallery-open
                      aria-label={t.misc.viewGallery}
                      class="block h-full w-full cursor-zoom-in"
                    >
                      <img
                        data-gallery-cover
                        src={coverSrc}
                        alt={`${p.name} — ${t.misc.screenshot} 1`}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                      />
                    </button>
                  ) : (
                    <img
                      src={coverSrc}
                      alt={p.name}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                    />
                  )}
                  <div
                    class:list={[
                      'pointer-events-none absolute inset-0 bg-gradient-to-t from-surface via-surface/20 to-transparent lg:bg-gradient-to-r',
                      flip && 'lg:bg-gradient-to-l',
                    ]}
                  />
                  <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-void/70 px-3 py-1.5 text-[0.65rem] font-semibold text-brand-bright backdrop-blur">
                    <Icon name="lucide:star" class="h-3 w-3" />
                    {t.misc.featured}
                  </span>
                  {p.gallery?.length ? (
                    <span class="pointer-events-none absolute bottom-20 right-4 grid h-9 w-9 place-items-center rounded-lg bg-void/70 text-brand-bright backdrop-blur print:hidden">
                      <Icon name="lucide:maximize-2" class="h-4 w-4" />
                    </span>
                  ) : null}
                </div>

                <script is:inline type="application/json" data-gallery-data set:html={JSON.stringify({ name: p.name, images: p.gallery ?? [] })} />

                {p.gallery && p.gallery.length > 1 && (
                  <div class="flex flex-wrap gap-2 border-t border-white/[0.06] px-5 py-3 print:hidden">
                    {p.gallery.map((g, gi) => (
                      <button
                        type="button"
                        data-gallery-thumb={gi}
                        data-src={g}
                        aria-label={`${t.misc.screenshot} ${gi + 1}`}
                        aria-current={gi === 0 ? 'true' : 'false'}
                        class:list={[
                          'h-14 w-24 shrink-0 overflow-hidden rounded-md transition-opacity duration-200',
                          gi === 0 ? 'ring-2 ring-brand-bright' : 'opacity-60 hover:opacity-100',
                        ]}
                      >
                        <img src={g} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <div class:list={['flex flex-col justify-center p-6 sm:p-8 lg:p-10', flip && 'lg:order-1']}>
                <p class="font-mono text-xs text-faint">{p.date}</p>
                <h3 class="mt-2 font-display text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
                  {p.name}
                </h3>
                <p class="mt-1 text-sm font-semibold text-brand-bright">
                  {p.role}{p.company && <span class="text-faint"> · {p.company}</span>}
                </p>
                <p class="mt-4 text-sm leading-relaxed text-muted sm:text-base">{p.summary}</p>

                <ul class="mt-5 space-y-2.5">
                  {p.highlights.map((h) => (
                    <li class="flex gap-2.5 text-sm text-muted">
                      <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-bright" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>

                <ul class="mt-6 flex flex-wrap gap-2">
                  {p.stack.map((tk) => <li class="chip">{tk}</li>)}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((p, i) => (
          <article
            class="reveal glass group flex flex-col rounded-2xl p-6 transition-transform duration-300 hover:-translate-y-1"
            data-delay={(i % 3) * 80}
          >
            <div class="flex items-center justify-between">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-brand/12 text-brand-bright ring-1 ring-brand/25 transition-transform duration-300 group-hover:scale-110">
                <Icon name="lucide:folder-git-2" class="h-5 w-5" />
              </span>
              <span class="font-mono text-xs text-faint">{p.date}</span>
            </div>

            <h3 class="mt-4 font-display text-lg font-bold text-ink">{p.name}</h3>
            <p class="mt-0.5 text-xs font-semibold text-brand-bright">{p.role}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{p.summary}</p>

            <ul class="mt-4 space-y-1.5">
              {p.highlights.map((h) => (
                <li class="flex gap-2 text-xs text-faint">
                  <Icon name="lucide:dot" class="h-4 w-4 shrink-0 text-brand/60" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <ul class="mt-4 flex flex-wrap gap-1.5">
              {p.stack.map((tk) => (
                <li class="chip py-1 text-[0.7rem]">{tk}</li>
              ))}
            </ul>

            {p.url && (
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-bright link-underline"
              >
                {t.actions.visitSite}
                <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
              </a>
            )}
          </article>
        ))
      }
    </div>

    <div class="reveal mt-4 flex flex-col items-center justify-between gap-4 rounded-2xl glass p-6 text-center sm:flex-row sm:text-left" data-delay="120">
      <div>
        <h3 class="font-display text-lg font-bold text-ink">{t.actions.moreOnGithub}</h3>
        <p class="text-sm text-muted">{profile.github.replace('https://github.com/', 'github.com/')}</p>
      </div>
      <a
        href={profile.github}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-semibold text-void transition-all duration-200 hover:bg-brand-bright hover:shadow-[0_0_28px_-6px] hover:shadow-brand/60"
      >
        <Icon name="simple-icons:github" class="h-4 w-4" />
        {profile.github.replace('https://github.com/', '@')}
      </a>
    </div>
  </div>

  <dialog
    id="project-lightbox"
    class="m-auto w-[min(72rem,94vw)] bg-transparent p-0 backdrop:bg-void/85 backdrop:backdrop-blur-sm"
    aria-label={t.misc.screenshot}
  >
    <figure class="glass-strong overflow-hidden rounded-2xl">
      <img id="lightbox-img" src="" alt="" decoding="async" class="max-h-[76vh] w-full bg-surface object-contain object-top" />
      <figcaption class="flex items-center justify-between gap-4 px-5 py-3">
        <span id="lightbox-caption" class="truncate font-mono text-xs text-faint" />
        <span class="flex shrink-0 items-center gap-1">
          <span id="lightbox-counter" class="mr-2 font-mono text-xs text-faint" />
          <button
            type="button"
            data-lightbox-prev
            aria-label={t.misc.prev}
            class="grid h-9 w-9 place-items-center rounded-lg text-muted transition-colors hover:bg-white/5 hover:text-ink"
          >
            <Icon name="lucide:chevron-left" class="h-5 w-5" />
          </button>
          <button
            type="button"
            data-lightbox-next
            aria-label={t.misc.next}
            class="grid h-9 w-9 place-items-center rounded-lg text-muted transition-colors hover:bg-white/5 hover:text-ink"
          >
            <Icon name="lucide:chevron-right" class="h-5 w-5" />
          </button>
          <button
            type="button"
            data-lightbox-close
            aria-label={t.misc.close}
            autofocus
            class="grid h-9 w-9 place-items-center rounded-lg text-muted transition-colors hover:bg-white/5 hover:text-ink"
          >
            <Icon name="lucide:x" class="h-5 w-5" />
          </button>
        </span>
      </figcaption>
    </figure>
  </dialog>
</section>

<script>
  const dialog = document.getElementById('project-lightbox') as HTMLDialogElement | null;

  if (dialog) {
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const caption = document.getElementById('lightbox-caption')!;
    const counter = document.getElementById('lightbox-counter')!;

    let slides: string[] = [];
    let name = '';
    let shot = '';
    let idx = 0;
    let opener: HTMLElement | null = null;

    const paint = () => {
      img.src = slides[idx] ?? '';
      img.alt = `${name} — ${shot} ${idx + 1}`;
      caption.textContent = name;
      counter.textContent = `${idx + 1} / ${slides.length}`;
    };

    const openAt = (root: HTMLElement, start: number) => {
      const raw = root.querySelector<HTMLScriptElement>('script[data-gallery-data]')?.textContent;
      if (!raw) return;
      let data: { name?: string; images?: string[] };
      try {
        data = JSON.parse(raw);
      } catch {
        return;
      }
      slides = data.images ?? [];
      if (!slides.length) return;
      name = data.name ?? '';
      shot = root.dataset.screenshot ?? '';
      idx = Math.min(Math.max(start, 0), slides.length - 1);
      paint();
      opener = document.activeElement as HTMLElement | null;
      dialog.showModal();
      document.documentElement.classList.add('overflow-hidden');
    };

    const move = (delta: number) => {
      if (!slides.length) return;
      idx = (idx + delta + slides.length) % slides.length;
      paint();
    };

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('overflow-hidden');
      img.src = '';
      slides = [];
      opener?.focus();
      opener = null;
    });

    document.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;

      const thumb = target.closest<HTMLElement>('[data-gallery-thumb]');
      if (thumb) {
        const root = thumb.closest<HTMLElement>('[data-gallery]');
        const cover = root?.querySelector<HTMLImageElement>('[data-gallery-cover]');
        const src = thumb.dataset.src;
        if (!root || !cover || !src) return;
        const i = Number(thumb.dataset.galleryThumb ?? 0);
        cover.src = src;
        cover.alt = `${root.dataset.name ?? ''} — ${root.dataset.screenshot ?? ''} ${i + 1}`;
        root.dataset.index = String(i);
        for (const el of root.querySelectorAll('[data-gallery-thumb]')) {
          const active = el === thumb;
          el.classList.toggle('ring-2', active);
          el.classList.toggle('ring-brand-bright', active);
          el.classList.toggle('opacity-60', !active);
          el.setAttribute('aria-current', active ? 'true' : 'false');
        }
        return;
      }

      const trigger = target.closest<HTMLElement>('[data-gallery-open]');
      if (trigger && !dialog.open) {
        const root = trigger.closest<HTMLElement>('[data-gallery]');
        if (root) openAt(root, Number(root.dataset.index ?? 0));
        return;
      }

      if (target.closest('[data-lightbox-prev]')) return move(-1);
      if (target.closest('[data-lightbox-next]')) return move(1);
      if (target.closest('[data-lightbox-close]')) return dialog.close();
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') move(-1);
      else if (e.key === 'ArrowRight') move(1);
    });
  }
</script>
