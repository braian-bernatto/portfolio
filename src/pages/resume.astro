---
import Layout from '../layouts/Layout.astro';
import ResumeView from '../components/ResumeView.astro';
import { getPortfolio } from '../data/portfolio';

const { profile } = getPortfolio('en');
const title = `${profile.name} — Resume`;
---

<Layout locale="en" title={title} description={profile.summary}>
  <ResumeView locale="en" />
</Layout>
